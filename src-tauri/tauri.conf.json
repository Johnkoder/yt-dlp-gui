{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp GUI",
  "version": "0.1.0",
  "identifier": "com.ytdlp.gui",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp GUI",
        "width": 760,
        "height": 500,
        "minWidth": 620,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/bin/yt-dlp.exe"]
  }
}
